#!/bin/sh
# CGI endpoint: returns OpenVPN client certificate/profile inventory as JSON.
set -eu

CA_DIR="/ca"
PKI="$CA_DIR/pki"
CLIENT_DIR="$CA_DIR/clients"

printf 'Content-Type: application/json; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

# Client names are generated by EasyRSA and are expected to be safe filename tokens.
# Only inspect issued client certificates; never expose private keys or profile contents.
printf '{"success":true,"clients":['
first=1
count=0

if [ -d "$PKI/issued" ]; then
    for cert in "$PKI"/issued/*.crt; do
        [ -f "$cert" ] || continue
        name=${cert##*/}
        name=${name%.crt}
        [ "$name" = "server" ] && continue
        case "$name" in
            *[!A-Za-z0-9_.-]*|'') continue ;;
        esac

        profile_dir="$CLIENT_DIR/$name/ovpn"
        profile_exists=false
        [ -d "$profile_dir" ] && profile_exists=true

        status="VALID"
        # EasyRSA index rows begin with V (valid), R (revoked), or E (expired).
        if [ -f "$PKI/index.txt" ]; then
            row=$(grep -F "/CN=$name" "$PKI/index.txt" | tail -n 1 || true)
            case "$row" in
                R\ *) status="REVOKED" ;;
                E\ *) status="EXPIRED" ;;
                V\ *)
                    if ! openssl x509 -checkend 0 -noout -in "$cert" >/dev/null 2>&1; then
                        status="EXPIRED"
                    fi
                    ;;
                *)
                    if ! openssl x509 -checkend 0 -noout -in "$cert" >/dev/null 2>&1; then
                        status="EXPIRED"
                    fi
                    ;;
            esac
        elif ! openssl x509 -checkend 0 -noout -in "$cert" >/dev/null 2>&1; then
            status="EXPIRED"
        fi

        expiry=$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | sed 's/^notAfter=//' || true)
        [ -n "$expiry" ] || expiry="unknown"

        [ "$first" -eq 1 ] || printf ','
        first=0
        # Values are restricted/derived from certificate filenames; expiry is escaped conservatively.
        expiry=$(printf '%s' "$expiry" | sed 's/\\/\\\\/g; s/"/\\"/g')
        printf '{"name":"%s","status":"%s","profile":%s,"expires":"%s"}' \
            "$name" "$status" "$profile_exists" "$expiry"
        count=$((count + 1))
    done
fi

folder_count=$(find "$CLIENT_DIR" -type d -name ovpn 2>/dev/null | wc -l | tr -d '[:space:]')
printf '],"count":%s}\n' "${folder_count:-0}"
