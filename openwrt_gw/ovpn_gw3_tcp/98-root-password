#!/bin/sh
# Applied once by OpenWrt uci-defaults on first container boot.
set -eu
HASH_FILE=/etc/pnf/openwrt-root.hash
[ -r "$HASH_FILE" ] || { echo "Missing OpenWrt root password hash" >&2; exit 1; }
IFS= read -r HASH < "$HASH_FILE" || [ -n "${HASH:-}" ]
case "$HASH" in
    '$6$'*) ;;
    *) echo "Invalid OpenWrt root password hash" >&2; exit 1 ;;
esac
# SHA-512-crypt contains no '#' characters, so the sed delimiter is safe.
sed -i "s#^root:[^:]*:#root:${HASH}:#" /etc/shadow
unset HASH
exit 0
