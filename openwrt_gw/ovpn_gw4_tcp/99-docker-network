#!/bin/sh

#
# Cleanup OpenWrt defaults
#

# Network cleanup
uci delete network.@device[0] 2>/dev/null
uci delete network.lan 2>/dev/null
uci delete network.wan 2>/dev/null
uci delete network.wan6 2>/dev/null
uci delete network.vpn 2>/dev/null
uci delete network.globals.ula_prefix 2>/dev/null

# DHCP cleanup
uci delete dhcp.lan 2>/dev/null
uci delete dhcp.wan 2>/dev/null
uci delete dhcp.wan6 2>/dev/null

# Firewall cleanup
while uci -q delete firewall.@forwarding[0]; do :; done
while uci -q delete firewall.@rule[0]; do :; done
while uci -q delete firewall.@zone[0]; do :; done

uci delete firewall.lan 2>/dev/null
uci delete firewall.wan 2>/dev/null
uci delete firewall.vpn_wan 2>/dev/null


#
# WAN (IPv4)
#

uci set network.wan='interface'
uci set network.wan.device='eth0'
uci set network.wan.proto='static'

uci set network.wan.ipaddr='172.31.255.14'
uci set network.wan.netmask='255.255.255.0'
uci set network.wan.gateway='172.31.255.1'

uci add_list network.wan.dns='172.31.255.254'
uci add_list network.wan.dns='fdff:ffff:dc59:1312::254'


#
# WAN6 (IPv6)
#

uci set network.wan.ip6addr='fdff:ffff:dc59:1312::14/64'
uci set network.wan.ip6gw='fdff:ffff:dc59:1312::1'

# optional IPv6 DNS
#uci add_list network.wan.dns='fdff:ffff:dc59:1312::1'


#
# VPN (OpenVPN)
#

uci set network.vpn4='interface'
uci set network.vpn4.device='tun0'
uci set network.vpn4.proto='none'

uci set network.vpn4.auto='1'
uci set network.vpn4.force_link='1'
uci set network.vpn4.defaultroute='0'
uci set network.vpn4.delegate='0'

uci set network.vpn6='interface'
uci set network.vpn6.device='tun1'
uci set network.vpn6.proto='none'

uci set network.vpn6.auto='1'
uci set network.vpn6.force_link='1'
uci set network.vpn6.defaultroute='0'
uci set network.vpn6.delegate='0'
#
# DHCP
#

uci set dhcp.wan='dhcp'
uci set dhcp.wan.interface='wan'
uci set dhcp.wan.ignore='1'

uci set dhcp.wan6='dhcp'
uci set dhcp.wan6.interface='wan6'
uci set dhcp.wan6.ignore='1'


#
# Firewall WAN Zone
#

uci set firewall.wan='zone'
uci set firewall.wan.name='wan'

uci add_list firewall.wan.network='wan'
uci add_list firewall.wan.network='wan6'

uci set firewall.wan.input='ACCEPT'
uci set firewall.wan.output='ACCEPT'
uci set firewall.wan.forward='REJECT'

uci set firewall.wan.masq='1'
uci set firewall.wan.masq6='1'
uci set firewall.wan.mtu_fix='1'


#
# Firewall VPN Zone
#

uci set firewall.lan='zone'
uci set firewall.lan.name='lan'

uci add_list firewall.lan.network='vpn4'
uci add_list firewall.lan.network='vpn6'


uci set firewall.lan.input='REJECT'
uci set firewall.lan.output='ACCEPT'
uci set firewall.lan.forward='REJECT'


#
# Forward VPN -> WAN
#

uci set firewall.vpn_wan='forwarding'
uci set firewall.vpn_wan.src='lan'
uci set firewall.vpn_wan.dest='wan'


#
# Block VPN access to infrastructure (IPv4)
#

uci set firewall.block_vpn_infra4='rule'
uci set firewall.block_vpn_infra4.name='Block-VPN-Infrastructure-IPv4'
uci set firewall.block_vpn_infra4.src='lan'
uci set firewall.block_vpn_infra4.dest='wan'
uci set firewall.block_vpn_infra4.dest_ip='172.31.255.0/24'
uci set firewall.block_vpn_infra4.proto='all'
uci set firewall.block_vpn_infra4.family='ipv4'
uci set firewall.block_vpn_infra4.target='REJECT'


#
# Block VPN access to infrastructure (IPv6)
#

uci set firewall.block_vpn_infra6='rule'
uci set firewall.block_vpn_infra6.name='Block-VPN-Infrastructure-IPv6'
uci set firewall.block_vpn_infra6.src='lan'
uci set firewall.block_vpn_infra6.dest='wan'
uci set firewall.block_vpn_infra6.dest_ip='fdff:ffff:dc59:1312::/64'
uci set firewall.block_vpn_infra6.proto='all'
uci set firewall.block_vpn_infra6.family='ipv6'
uci set firewall.block_vpn_infra6.target='REJECT'

#
# Allow DNS from VPN to dnsmasq (IPv4 + IPv6)
#

uci set firewall.allow_dns_vpn='rule'
uci set firewall.allow_dns_vpn.name='Allow-DNS-VPN'
uci set firewall.allow_dns_vpn.src='lan'
uci set firewall.allow_dns_vpn.proto='tcp udp'
uci set firewall.allow_dns_vpn.dest_port='53'
uci set firewall.allow_dns_vpn.family='any'
uci set firewall.allow_dns_vpn.target='ACCEPT'

#
# Save
#

uci commit network
uci commit dhcp
uci commit firewall

exit 0
