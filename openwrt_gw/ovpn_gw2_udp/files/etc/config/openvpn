config openvpn 'tun_worker_udp'
        option dev 'tun0'
        option proto 'udp'
        option port '1194'
        option ca '/etc/openvpn/ca.crt'
        option cert '/etc/openvpn/server.crt'
        option key '/etc/openvpn/server.key'
        option dh '/etc/openvpn/dh.pem'
        option tls_crypt '/etc/openvpn/tls-crypt.key'
        option server '172.31.254.0 255.255.255.128'
        option server_ipv6 'fdff:dc59:0000:0000::/64'
        option persist_key '1'
        option persist_tun '1'
        option tun_mtu '1280'
        option mssfix '1200'
        option client_to_client '0'
        option sndbuf '524288'
        option rcvbuf '524288'
        option enabled '1'
        option data_ciphers 'CHACHA20:POLY1305'
        option verb '3'
        option topology 'subnet'
        option keepalive '5 20'
        list push 'sndbuf 524288'
        list push 'rcvbuf 524288'
        list push 'redirect-gateway def1 ipv6'
        list push 'route-ipv6 ::/0'
        list push 'dhcp-option DNS 172.31.254.1'
        list push 'dhcp-option DNS fdff:dc59:0000:0000::1'

